{
  "$schema": "../../schemas/asset.schema.json",
  "schemaVersion": 2,
  "id": "vernier-caliper",
  "title": "Vernier Caliper (স্লাইড ক্যালিপার্স)",
  "type": "interactive",
  "entry": "index.html",
  "version": "0.3.6",
  "book": "physics-9-10",
  "page": 20,
  "topic": "1.6",
  "placement": "Book page 20, topic 1.6: slide calipers (স্লাইড ক্যালিপার্স). Embed this figure there, in place of the printed slide-calipers picture or right below it.",
  "order": 1,
  "maintainers": ["RadeenXALNW"],
  "units": "mm",
  "description": "Interactive 3D slide calipers for students. Drag the jaw and read M + V × VC (each part named), measure an object, rotate it in 3D, then take a 5-question multiple-choice test. Phone-first, Bangla. The full tool set (tour, settings, typed practice, inside jaws, depth rod) is behind ?ui=full.",
  "tags": ["measurement", "vernier", "slide calipers", "least count", "zero error", "bangla"],
  "params": [
    {
      "name": "lang",
      "label": "Language",
      "type": "select",
      "options": [["bn", "বাংলা"], ["en", "English"]],
      "default": "bn"
    },
    {
      "name": "lc",
      "label": "Least count (VC)",
      "type": "select",
      "options": [["0.1", "0.1 mm (10 div)"], ["0.05", "0.05 mm (20 div)"], ["0.02", "0.02 mm (50 div)"]],
      "default": "0.1"
    },
    { "name": "ze", "label": "Zero error", "type": "number", "default": "0", "help": "mm, e.g. 0.2 or -0.3" },
    { "name": "value", "label": "Starting jaw gap", "type": "number", "default": "24.6", "help": "mm" },
    {
      "name": "specimen",
      "label": "Object",
      "type": "select",
      "options": [
        ["", "none"],
        ["sphere", "pendulum bob"],
        ["cylinder", "brass cylinder"],
        ["block", "wooden block"],
        ["ring", "brass pipe (inside jaws)"],
        ["bore", "drilled block (depth)"]
      ],
      "default": ""
    },
    { "name": "size", "label": "Object size", "type": "number", "default": "", "help": "mm" },
    {
      "name": "mode",
      "label": "Start in",
      "type": "select",
      "options": [["explore", "learn"], ["quiz", "test (simple) / practice (full)"], ["tour", "guided tour (full)"]],
      "default": "explore"
    },
    {
      "name": "view",
      "label": "View",
      "type": "select",
      "options": [["front", "front"], ["3d", "3D"]],
      "default": "front"
    },
    { "name": "magnifier", "label": "Magnifier", "type": "boolean", "default": "1" },
    { "name": "guides", "label": "Colour guides", "type": "boolean", "default": "1" },
    { "name": "labels", "label": "Part names (full view)", "type": "boolean", "default": "0" },
    { "name": "hide", "label": "Hide reading (full view)", "type": "boolean", "default": "0" },
    { "name": "practiceZe", "label": "Practice with zero error (full view)", "type": "boolean", "default": "0" },
    { "name": "unit", "label": "Unit", "type": "select", "options": ["mm", "cm"], "default": "mm" },
    {
      "name": "numerals",
      "label": "Digits",
      "type": "select",
      "options": [["", "follow language"], ["bn", "০১২৩"], ["latin", "0123"]],
      "default": ""
    },
    { "name": "coach", "label": "First-use pointers (student view)", "type": "boolean", "default": "1" },
    {
      "name": "ui",
      "label": "UI",
      "type": "select",
      "options": [
        ["simple", "simple (student view)"],
        ["full", "full (all tools)"],
        ["compact", "compact (full, icon toolbar)"],
        ["none", "none (3D only)"]
      ],
      "default": "simple"
    },
    {
      "name": "bg",
      "label": "Background",
      "type": "select",
      "options": ["light", "dark", "transparent"],
      "default": "light"
    },
    { "name": "shadow", "label": "Soft shadow", "type": "boolean", "default": "1" },
    { "name": "sound", "label": "Sound", "type": "boolean", "default": "1" }
  ],
  "commands": [
    { "name": "get", "payload": {} },
    { "name": "set", "payload": { "value": 31.4 } },
    { "name": "set", "payload": { "specimen": "sphere", "size": 19.6 } },
    { "name": "set", "payload": { "lc": 0.02, "zeroError": -0.04 } },
    { "name": "reset", "payload": {} },
    { "name": "tour", "payload": {} },
    { "name": "practice", "payload": {} },
    { "name": "capture", "payload": { "width": 800, "height": 500 } },
    { "name": "export-glb", "payload": {} }
  ],
  "events": [
    "ready",
    "change",
    "specimen",
    "view",
    "settings",
    "dragstart",
    "dragend",
    "tour-step",
    "tour-end",
    "practice-start",
    "practice-result",
    "practice-end"
  ],
  "export": {
    "poster": { "params": { "coach": "0" } },
    "glb": [{ "name": "default" }],
    "video": {
      "kind": "script",
      "seconds": 14,
      "fps": 30,
      "params": { "coach": "0" },
      "script": [
        { "at": 0.5, "command": "set", "payload": { "value": 31.4 } },
        { "at": 3, "command": "set", "payload": { "specimen": "sphere", "size": 19.6 } },
        { "at": 8, "command": "set", "payload": { "view": "3d" } },
        { "at": 11.5, "command": "set", "payload": { "view": "front" } }
      ]
    }
  }
}
