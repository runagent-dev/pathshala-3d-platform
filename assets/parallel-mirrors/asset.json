    { "name": "practice", "payload": {} },
    { "name": "capture", "payload": { "width": 800, "height": 500 } },
    { "name": "export-glb", "payload": {} }
  ],
  "events": ["ready", "change", "view", "dragstart", "dragend", "practice-start", "practice-result", "practice-end"],
