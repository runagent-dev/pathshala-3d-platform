    {
      "name": "numerals",
      "label": "Digits",
      "type": "select",
      "options": [["", "follow language"], ["bn", "Bangla"], ["latin", "Latin"]],
      "default": ""
    },
    { "name": "bg", "label": "Background", "type": "select", "options": ["light", "transparent"], "default": "light" },
