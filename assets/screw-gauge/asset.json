{
  "$schema": "../../schemas/asset.schema.json",
  "schemaVersion": 2,
  "id": "screw-gauge",
  "title": "Screw gauge (স্ক্রু-গেইজ)",
  "type": "interactive",
  "entry": "index.html",
  "version": "0.3.0",
  "book": "physics-9-10",
  "page": 21,
  "topic": "1.6.1",
  "placement": "Book page 21, topic 1.6.1: স্ক্রু-গেইজ (Screw Gauge). Put it next to Figure 1.08 (চিত্র ১.০৮), or in place of the screw-gauge photo in that figure.",
  "order": 3,
  "maintainers": ["RadeenXALNW"],
  "units": "mm",
  "description": "Interactive 3D screw gauge as in the book: pitch 1 mm, 100 parts on the circular scale, least count 0.01 mm. Turn the thimble (drag across it, or drag along it to move fast; wheel and arrow keys for one part), the ratchet clicks when it meets the object. Learn tab: reading = L + C × LC with each part named and the book's least-count sentence. Test tab: 5 multiple-choice readings of a copper wire, steel ball or glass plate. Magnifier, first-use pointers, phone-first layout.",
  "tags": ["measurement", "screw gauge", "micrometer", "least count", "pitch", "bangla"],
  "params": [
    {
      "name": "lang",
      "label": "Language",
      "type": "select",
      "options": [["bn", "বাংলা"], ["en", "English"]],
      "default": "bn"
    },
    {
      "name": "value",
      "label": "Starting reading",
      "type": "number",
      "default": "3.47",
      "placeholder": "mm, e.g. 3.47"
    },
    {
      "name": "object",
      "label": "Object",
      "type": "select",
      "options": [["", "none"], ["wire", "copper wire"], ["ball", "steel ball"], ["plate", "glass plate"]],
      "default": ""
    },
    { "name": "size", "label": "Object size", "type": "number", "default": "", "placeholder": "mm" },
    {
      "name": "mode",
      "label": "Start in",
      "type": "select",
      "options": [["explore", "learn"], ["quiz", "test"]],
      "default": "explore"
    },
    { "name": "view", "label": "View", "type": "select", "options": ["front", "3d"], "default": "front" },
    { "name": "magnifier", "label": "Magnifier", "type": "boolean", "default": "1" },
    { "name": "guides", "label": "Colour the marks read", "type": "boolean", "default": "1" },
    { "name": "coach", "label": "First-use pointers", "type": "boolean", "default": "1" },
    {
      "name": "numerals",
      "label": "Digits",
      "type": "select",
      "options": [["", "follow language"], ["bn", "Bangla"], ["latin", "Latin"]],
      "default": ""
    },
    { "name": "bg", "label": "Background", "type": "select", "options": ["light", "transparent"], "default": "light" },
    { "name": "shadow", "label": "Soft shadow", "type": "boolean", "default": "1" },
    { "name": "sound", "label": "Sound", "type": "boolean", "default": "1" }
  ],
  "commands": [
    { "name": "get", "payload": {} },
    { "name": "set", "payload": { "value": 7.05 } },
    { "name": "set", "payload": { "object": "ball", "size": 6.35 } },
    { "name": "reset", "payload": {} },
    { "name": "practice", "payload": {} },
    { "name": "capture", "payload": { "width": 800, "height": 500 } },
    { "name": "export-glb", "payload": {} }
  ],
  "events": [
    "ready",
    "change",
    "object",
    "view",
    "dragstart",
    "dragend",
    "practice-start",
    "practice-result",
    "practice-end"
  ],
  "export": {
    "poster": {
      "params": { "coach": "0" },
      "setup": [{ "command": "set", "payload": { "object": "ball", "size": 6.35, "animate": false } }]
    },
    "glb": [
      { "name": "default" },
      {
        "name": "wire",
        "setup": [{ "command": "set", "payload": { "object": "wire", "size": 1.24, "animate": false } }]
      }
    ],
    "video": {
      "kind": "script",
      "seconds": 14,
      "fps": 30,
      "params": { "coach": "0" },
      "script": [
        { "at": 0.5, "command": "set", "payload": { "value": 7.36 } },
        { "at": 3, "command": "set", "payload": { "object": "wire", "size": 1.24 } },
        { "at": 8, "command": "set", "payload": { "view": "3d" } },
        { "at": 11.5, "command": "set", "payload": { "view": "front" } }
      ]
    }
  }
}
