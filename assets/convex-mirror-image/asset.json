        ["ray3", "ray toward the focus"],
        ["image", "the image X′Y′"],
        ["move", "moving the pencil"],
        ["plane", "a plane mirror, from the eye"],
        ["eye", "the convex mirror, from the eye"],
        ["wide", "both fields of view, from above"]
      ],
      "default": "see"
