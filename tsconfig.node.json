{
  // Type-checks the Node side (studio, scripts, tests) from its JavaScript and JSDoc. `npm run types`.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": { "@shared/*": ["./shared/lib/*"] }
  },
  "include": ["scripts/**/*.mjs", "test/**/*.mjs", "assets/*/tests/**/*.mjs", "playwright.config.mjs", "types/*.d.ts"],
  "exclude": ["node_modules"]
}
