{
  "name": "pathshala-3d",
  "version": "0.2.0",
  "private": true,
  "description": "3D and interactive figures for the Pathshala interactive books. One self-contained folder per asset.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:public": "node scripts/dev.mjs --public",
    "setup": "node scripts/setup.mjs",
    "new": "node scripts/new-asset.mjs",
    "check": "node scripts/check/index.mjs",
    "generate": "node scripts/generate.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "types": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.figures.json",
    "test": "npm run test:unit && npm run test:figures",
    "test:unit": "node --test --test-reporter=spec --import ./test/register.mjs \"test/unit/**/*.test.mjs\"",
    "test:figures": "playwright test",
    "test:visual": "node scripts/visual.mjs",
    "package": "node scripts/package.mjs",
    "package:all": "node scripts/package.mjs --all",
    "vendor:three": "node scripts/vendor-three.mjs",
    "test:templates": "node scripts/test-templates.mjs",
    "verify": "node scripts/verify.mjs",
    "docs": "node scripts/docs.mjs",
    "find": "node scripts/find.mjs",
    "export": "node scripts/export.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/three": "0.185.4",
    "gltf-validator": "2.0.0-dev.3.10",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "three": "0.185.1",
    "typescript": "6.0.3"
  }
}
