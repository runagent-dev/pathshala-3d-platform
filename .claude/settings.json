{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run new:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run docs:*)",
      "Bash(npm run find:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run types:*)",
      "Bash(npm run generate:*)",
      "Bash(npm run package:*)",
      "Bash(npm run import:*)",
      "Bash(npm run export:*)",
      "Bash(npx playwright test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": ["Read(./.studio-auth.json)", "Read(./data/**)", "Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check/hook.mjs\"", "timeout": 30 }]
      }
    ]
  }
}
