# /etc/pathshala/studio.env — settings for the studio service (deploy/systemd/pathshala-studio.service).
# The studio listens on these addresses; the proxy (Traefik in Coolify) reaches it on the Docker gateway address.
PORT=4800
HOST=127.0.0.1,10.0.1.1
# Requests from these addresses may set X-Forwarded-For / X-Forwarded-Proto (the proxy's network).
TRUST_PROXY=127.0.0.1,10.0.1.0/24
# Where studio state and exports live (outside the checkout, backed up by deploy/backup/backup.sh).
PATHSHALA_DATA_DIR=/srv/pathshala/data
PATHSHALA_EXPORTS_DIR=/srv/pathshala/exports
PLAYWRIGHT_BROWSERS_PATH=/srv/pathshala/cache/ms-playwright
# Pull and push every 60 s; a push webhook (GitHub: Settings → Webhooks, content type JSON, this secret,
# URL https://<studio-domain>/api/hooks/git) makes merged pull requests appear at once.
PATHSHALA_GIT_SYNC_SECONDS=60
PATHSHALA_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Used in invite links printed by `npm run user`.
PATHSHALA_STUDIO_URL=https://studio.example.org
